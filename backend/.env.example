APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# hCaptcha Configuration
# Get your keys at: https://www.hcaptcha.com/
# Test Secret (auto-pass): 0x0000000000000000000000000000000000000000
# Production: Replace with your actual secret key
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# OpenRouter AI (Chatbot)
OPENROUTER_API_KEY=
AI_MODEL=google/gemini-2.5-flash-lite
GEMINIGEN_API_KEY=

CONTENT_ENGINE_URL=http://127.0.0.1:8100
CONTENT_ENGINE_API_KEY=prod-key-CHANGE-ME

# Article Generation
ARTICLE_GEN_DRIVER=ssh
ARTICLE_GEN_SSH_HOST=
ARTICLE_GEN_SSH_USER=claudesn
ARTICLE_GEN_SSH_KEY=
ARTICLE_GEN_CLAUDE_PATH=claude
ARTICLE_GEN_API_URL=https://alisadikinma.com/api
ARTICLE_GEN_API_TOKEN=

# Split pipeline refs + models
ARTICLE_GEN_REFS_PREP=
ARTICLE_GEN_REFS_WRITE=
ARTICLE_GEN_REFS_SCORE=
ARTICLE_GEN_REFS_IMAGES=
ARTICLE_GEN_MODEL_PREP=sonnet
ARTICLE_GEN_MODEL_WRITE=sonnet
ARTICLE_GEN_MODEL_SCORE=sonnet
ARTICLE_GEN_MODEL_IMAGES=sonnet

# Gate 2 Image Phase Split (feature flag — default off for safe rollout)
ARTICLE_GEN_USE_IMAGES_PHASE=false

# Finalize: Translation Pipeline (feature flag — default off for safe rollout)
ARTICLE_GEN_REFS_TRANSLATE=
ARTICLE_GEN_MODEL_TRANSLATE=sonnet
ARTICLE_GEN_USE_TRANSLATE_PHASE=false

# Phase C — Trim Scoring to Mechanical-Only (default off skips AI /article-score,
# saves ~1 min/article; mechanical snapshot written inline at write-done time.
# Flip to true to restore legacy 5-gate AI scoring on every article.)
ARTICLE_GEN_USE_SCORE_PHASE=false

# Phase B — Tiered Deep Research + Skill Split
ARTICLE_GEN_MODEL_RESEARCH_DEEP=opus       # Opus only for deep research step (virality_score >= 70)
ARTICLE_GEN_MODEL_RESEARCH_QUICK=sonnet    # Sonnet for quick research tier
ARTICLE_GEN_MODEL_STRATEGY_OUTLINE=sonnet  # Always Sonnet for strategy + outline
ARTICLE_GEN_REFS_RESEARCH=/home/claudesn/refs-research.md
ARTICLE_GEN_REFS_STRATEGY_OUTLINE=/home/claudesn/refs-strategy-outline.md
ARTICLE_GEN_SKILL_SPLIT_ENABLED=false      # Feature flag — flip to true once plugin skills deployed to VPS
ARTICLE_GEN_DEEP_RESEARCH_ENABLED=true     # Kill-switch for tier resolution; false forces quick even if virality_score >= 70

# Content Engine — Image Generation
DEFAULT_IMAGE_MODEL=nano-banana-pro
COVER_BRANDING_ENABLED=true
COVER_BRANDING_MODEL=nano-banana-pro
COVER_BRANDING_TITLE_MAX_LEN=70

# Content Engine — Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# Content Engine — Auto-Pipeline Window
CONTENT_AUTO_WINDOW_START=6
CONTENT_AUTO_WINDOW_END=22
CONTENT_AUTO_TIMEZONE=Asia/Jakarta

# Carousel Gen Plugin Bridge — used by LinkedInGenerationService for ALL
# LinkedIn carousel-format drafts (post linkedin-post-writer v0.5.0 — the
# legacy /linkedin-carousel skill is gone, no more flag-gating). Mirrors
# LINKEDIN_GEN_* SSH pattern.
CAROUSEL_GEN_DRIVER=ssh
CAROUSEL_GEN_SSH_HOST=localhost
CAROUSEL_GEN_SSH_USER=claudesn
CAROUSEL_GEN_SSH_KEY=/var/www/.ssh/id_ed25519
CAROUSEL_GEN_CLAUDE_PATH=claude
CAROUSEL_GEN_MODEL=sonnet
CAROUSEL_GEN_REFS_PIPELINE=/home/claudesn/refs-carousel-gen-pipeline.md
# 600s mirrors LINKEDIN_GEN_TIMEOUT_SECONDS — production-validated on post #24
# (369s wall) where the prior 300s caused timeout + orphan SSH + runaway retries.
CAROUSEL_GEN_TIMEOUT_SECONDS=600

# RETIRED in linkedin-post-writer v0.5.0:
#   LINKEDIN_USE_CAROUSEL_GEN_ENGINE — flag dropped, /carousel-gen is the only
#                                       carousel path now.
#   LINKEDIN_GEN_REFS_CAROUSEL       — refs-linkedin-carousel.md retired,
#                                       carousel design specs live in
#                                       /carousel-gen plugin's references.

# Cross-post pipeline (May 8, 2026) — fan LinkedIn posts out to FB Page + IG +
# TikTok via Publer. Two infrastructure sections:
#   1. SOCIAL_GEN_* — SSH bridge to social-short-form-writer plugin
#      (caption authoring via /instagram-gen + /tiktok-gen skills)
#   2. PUBLER_* — REST API integration for actual publish dispatch
#
# Operator-rotatable config (api_key, account IDs, master enable toggle)
# lives in DB `settings` table (group=publer) — NOT in .env.

SOCIAL_GEN_DRIVER=ssh                                            # 'ssh' (production) or 'local' (XAMPP dev)
SOCIAL_GEN_SSH_HOST=localhost
SOCIAL_GEN_SSH_USER=claudesn
SOCIAL_GEN_SSH_KEY=/home/claudesn/.ssh/id_ed25519                # Queue worker context — claudesn-owned key
SOCIAL_GEN_CLAUDE_PATH=claude
SOCIAL_GEN_MODEL=sonnet
SOCIAL_GEN_REFS_INSTAGRAM=/home/claudesn/refs-instagram.md       # Compiled from social-short-form-writer plugin
SOCIAL_GEN_REFS_TIKTOK=/home/claudesn/refs-tiktok.md             # ditto
SOCIAL_GEN_EMPTY_MCP_CONFIG=/home/claudesn/empty-mcp.json        # Required to prevent MCP leak (April 29 fix)
SOCIAL_GEN_TIMEOUT_SECONDS=300                                   # IG/TikTok plugins are text-only, run faster than carousel-gen

# Publer REST API integration. Auth header is `Authorization: Bearer-API {token}`
# (NOT plain `Bearer`). API key + account IDs encrypted in settings table.
PUBLER_BASE_URL=https://app.publer.com
PUBLER_API_PATH=/api/v1
PUBLER_MAX_RETRIES=3
PUBLER_RETRY_BACKOFF_MS=500
PUBLER_HTTP_TIMEOUT_SECONDS=30
