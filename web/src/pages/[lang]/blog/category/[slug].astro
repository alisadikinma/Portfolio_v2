---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PostCard, { type PostItem } from "../../../../components/PostCard.astro";
import Pagination from "../../../../components/Pagination.astro";
import { apiGet, apiGetPage, apiPath } from "../../../../lib/api";
import { LANGS, type Lang } from "../../../../lib/i18n";
import { clipWords, TITLE_MAX } from "../../../../lib/seo-text";
import { SITE, breadcrumb, collectionPage, graph, personNode, webPageNode, websiteNode } from "../../../../lib/schema";
import { id } from "../../../../content/copy/id";
import { en } from "../../../../content/copy/en";

const PER_PAGE = 12;

const raw = Astro.params.lang;
if (!(LANGS as readonly string[]).includes(raw ?? "")) {
  return new Response(null, { status: 404 });
}
const lang = raw as Lang;
const slug = Astro.params.slug ?? "";
if (slug === "" || slug === "." || slug === ".." || /[\\/]/.test(slug)) return new Response(null, { status: 404 });
const c = (lang === "id" ? id : en).blogCategory;
const fill = (s: string, name: string) => s.replaceAll("{name}", name);
const base = `/${lang}/blog/category/${encodeURIComponent(slug)}`;

// Page 1 has one URL only (no ?page): anything that is not a plain integer >= 2 redirects there.
const rawPage = Astro.url.searchParams.get("page");
let page = 1;
if (rawPage !== null) {
  if (!/^[1-9]\d*$/.test(rawPage) || rawPage === "1" || !Number.isSafeInteger(Number(rawPage))) {
    return Astro.redirect(base, 301);
  }
  page = Number(rawPage);
}

interface Category { name: string; slug: string }
let category: Category | null = null;
let items: PostItem[] = [];
let lastPage = 1;
let failed = false;
try {
  category = await apiGet<Category>(apiPath`/categories/${slug}`, { lang });
  if (category !== null) {
    if (typeof category.name !== "string" || category.name === "") throw new Error("bad category");
    const res = await apiGetPage<PostItem>(
      `/posts?category=${encodeURIComponent(slug)}&per_page=${PER_PAGE}&page=${page}`,
      { lang },
    );
    if (!res || !Array.isArray(res.data)) throw new Error("no data");
    items = res.data.filter((p) => p && typeof p.slug === "string" && p.slug !== "" && typeof p.title === "string");
    const lp = Number((res.meta as { last_page?: unknown } | null)?.last_page);
    lastPage = Number.isInteger(lp) && lp >= 1 ? lp : 1;
  }
} catch {
  failed = true;
}
if (!failed && category === null) return new Response(null, { status: 404 });
if (!failed && page > lastPage) return new Response(null, { status: 404 });
if (failed) {
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "120");
}

const name = category?.name ?? slug;
const pathFor = (p: number) => (p > 1 ? `${base}?page=${p}` : base);
const path = pathFor(page);
const url = SITE + path;
const baseTitle = fill(c.metaTitle, name);
const pageSuffix = page > 1 ? ` (${c.pageLabel} ${page})` : "";
const title = clipWords(baseTitle, TITLE_MAX - pageSuffix.length) + pageSuffix;
const description = clipWords(fill(c.metaDescription, name), 160);
const noindex = failed || items.length === 0;

const nodes = [
  personNode(),
  websiteNode(),
  webPageNode({ url, lang, name: title, description }),
  breadcrumb([
    { name: c.breadcrumbHome, url: `${SITE}/${lang}` },
    { name: c.breadcrumbBlog, url: `${SITE}/${lang}/blog` },
    { name, url: SITE + base },
  ]),
];
if (!failed) {
  nodes.push(
    collectionPage({
      url,
      lang,
      name: title,
      description,
      items: items.map((p) => ({ name: p.title, url: `${SITE}/${lang}/blog/${encodeURIComponent(p.localized_slug || p.slug)}` })),
    }),
  );
}
const jsonld = graph(...nodes);
const prev = !failed && page > 1 ? pathFor(page - 1) : undefined;
const next = !failed && page < lastPage ? pathFor(page + 1) : undefined;
---
<BaseLayout title={title} description={description} path={path} lang={lang} jsonld={jsonld} prev={prev} next={next} noindex={noindex}>
  <main class="wrap blog-index">
    <h1>{name}</h1>
    <p>{fill(c.intro, name)}</p>
    {failed
      ? <p class="blog-unavailable" role="status">{c.unavailable}</p>
      : items.length === 0
        ? <p class="blog-empty" role="status">{c.empty}</p>
        : (
          <div class="blog-grid">
            {items.map((p, i) => <PostCard post={p} lang={lang} minRead={c.minRead} eager={page === 1 && i === 0} />)}
          </div>
        )}
    {!failed && <Pagination current={page} last={lastPage} hrefFor={pathFor} labels={{ aria: c.paginationAria, prev: c.prev, next: c.next, page: c.pageLabel }} />}
    <p class="blog-links">
      {c.linkBlogLead} <a href={`/${lang}/blog`}>{c.linkBlog}</a>.
      {" "}{c.linkFaqLead} <a href={`/${lang}/faq`}>{c.linkFaq}</a>.
    </p>
  </main>
</BaseLayout>
<style>
  .blog-grid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); margin: 2rem 0; }
</style>
