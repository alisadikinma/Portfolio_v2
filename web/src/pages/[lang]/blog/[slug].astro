---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard, { type PostItem } from "../../../components/PostCard.astro";
import AuthorBox from "../../../components/AuthorBox.astro";
import { apiGetPost } from "../../../lib/api";
import { LANGS, type Lang } from "../../../lib/i18n";
import { sanitizeHtml } from "../../../lib/sanitize";
import { SITE, blogPosting, breadcrumb, graph, personNode, webPageNode, websiteNode } from "../../../lib/schema";
import { id } from "../../../content/copy/id";
import { en } from "../../../content/copy/en";

interface PostDetail {
  slug: string;
  title: string;
  excerpt?: string | null;
  content?: string | null;
  featured_image?: string | null;
  image_variants?: Record<string, string> | null;
  published_at?: string | null;
  created_at?: string | null;
  updated_at?: string | null;
  reading_time?: number | null;
  category?: { name?: string; slug?: string } | null;
  seo?: { meta_title?: string | null; meta_description?: string | null; og_image?: string | null } | null;
  available_translations?: string[] | null;
  related_posts?: PostItem[] | null;
}

const raw = Astro.params.lang;
if (!(LANGS as readonly string[]).includes(raw ?? "")) {
  return new Response(null, { status: 404 });
}
const lang = raw as Lang;
const slug = Astro.params.slug ?? "";
if (slug === "") return new Response(null, { status: 404 });
const c = (lang === "id" ? id : en).blogDetail;
const NAME = "Ali Sadikin Ma";

let post: PostDetail | null = null;
let failed = false;
try {
  post = await apiGetPost<PostDetail>(slug, { lang });
  if (post && (typeof post.title !== "string" || post.title === "")) throw new Error("malformed post");
} catch {
  failed = true;
  post = null;
}
if (!failed && !post) return new Response(null, { status: 404 });

// The API falls back to the English text when the requested language is missing, so
// available_translations is the truth: send the visitor to the language that exists.
if (post) {
  const have = (post.available_translations ?? []).filter((l): l is Lang => (LANGS as readonly string[]).includes(l));
  if (have.length === 0) return new Response(null, { status: 404 });
  if (!have.includes(lang)) return Astro.redirect(`/${have[0]}/blog/${encodeURIComponent(slug)}`, 301);
}
if (failed) Astro.response.status = 503;

const path = `/${lang}/blog/${encodeURIComponent(slug)}`;
const url = SITE + path;

const clip = (s: string, max: number) => {
  if (s.length <= max) return s;
  const cut = s.slice(0, max - 3);
  return cut.slice(0, cut.lastIndexOf(" ") > max / 2 ? cut.lastIndexOf(" ") : cut.length).trimEnd() + "...";
};
// Title: max 60 chars and must carry the author name.
const fitTitle = (t: string) => {
  const tail = ` | ${NAME}`;
  const base = t.replace(new RegExp(`\\s*[—|-]\\s*${NAME}\\s*$`), "").trim();
  return clip(base, 60 - tail.length) + tail;
};

const title = post ? fitTitle(post.seo?.meta_title || post.title) : `${NAME}`;
const description = post ? clip((post.seo?.meta_description || post.excerpt || "").trim(), 160) : c.unavailable;

const toIso = (v?: string | null) => {
  if (!v) return null;
  const d = new Date(v);
  return Number.isNaN(d.getTime()) ? null : d;
};
const published = post ? toIso(post.published_at) ?? toIso(post.created_at) : null;
const modified = post ? toIso(post.updated_at) ?? published : null;
const fmt = (d: Date) =>
  new Intl.DateTimeFormat(lang === "id" ? "id-ID" : "en-US", { dateStyle: "long", timeZone: "UTC" }).format(d);

// Images: image_variants are relative to the API origin (same logic as PostCard).
let origin = "";
try {
  if (post?.featured_image) origin = new URL(post.featured_image).origin;
} catch {
  origin = "";
}
const absUrl = (u: string) => (/^https?:\/\//.test(u) ? u : origin ? origin + u : u);
const variants = Object.entries(post?.image_variants ?? {})
  .map(([k, v]) => ({ w: /^(\d+)w$/.exec(k)?.[1], url: v }))
  .filter((x): x is { w: string; url: string } => !!x.w && typeof x.url === "string" && x.url !== "")
  .sort((a, b) => Number(a.w) - Number(b.w));
const srcset = variants.length > 0 ? variants.map((v) => `${absUrl(v.url)} ${v.w}w`).join(", ") : undefined;
const heroSrc = post?.featured_image ?? (variants.length > 0 ? absUrl(variants[variants.length - 1].url) : "");
const ogImage = post?.seo?.og_image || (heroSrc && /^https:\/\//.test(heroSrc) ? heroSrc : undefined);

const cat = post?.category?.name && post.category.slug ? { name: post.category.name, slug: post.category.slug } : null;
const crumbs = [
  { name: c.breadcrumbHome, url: `${SITE}/${lang}` },
  { name: c.breadcrumbBlog, url: `${SITE}/${lang}/blog` },
  ...(cat ? [{ name: cat.name, url: `${SITE}/${lang}/blog/category/${encodeURIComponent(cat.slug)}` }] : []),
  ...(post ? [{ name: post.title, url }] : []),
];

const nodes = [personNode(), websiteNode(), webPageNode({ url, lang, name: title, description })];
if (post && published) {
  nodes.push(
    blogPosting({
      title: post.title,
      url,
      datePublished: published.toISOString(),
      dateModified: (modified ?? published).toISOString(),
      image: ogImage,
      lang,
      description,
    }),
    breadcrumb(crumbs),
  );
} else if (post) {
  nodes.push(breadcrumb(crumbs));
}
const jsonld = graph(...nodes);

const body = post ? sanitizeHtml(post.content ?? "") : "";
const related = (post?.related_posts ?? [])
  .filter((p) => p && typeof p.slug === "string" && p.slug !== "" && typeof p.title === "string" && p.title.trim() !== "")
  .slice(0, 3);
---
<BaseLayout title={title} description={description} path={path} lang={lang} jsonld={jsonld} image={ogImage} type="article">
  {failed || !post
    ? (
      <main class="wrap post-detail">
        <p class="blog-unavailable" role="status">{c.unavailable}</p>
        <p><a href={`/${lang}/blog`}>{c.backToBlog}</a></p>
      </main>
    )
    : (
      <main class="wrap post-detail">
        <article>
          <header>
            <h1>{post.title}</h1>
            <div class="post-meta">
              {cat && <a href={`/${lang}/blog/category/${encodeURIComponent(cat.slug)}`}>{cat.name}</a>}
              {published && <span>{c.publishedLabel} <time datetime={published.toISOString()}>{fmt(published)}</time></span>}
              {modified && published && modified.getTime() !== published.getTime() && (
                <span>{c.updatedLabel} <time datetime={modified.toISOString()}>{fmt(modified)}</time></span>
              )}
              {post.reading_time ? <span>{post.reading_time} {c.minRead}</span> : null}
            </div>
            {post.excerpt && <p class="post-lede">{post.excerpt}</p>}
          </header>
          {heroSrc && (
            <img
              class="post-hero"
              src={heroSrc}
              srcset={srcset}
              sizes={srcset ? "(min-width: 900px) 800px, 100vw" : undefined}
              width="1200"
              height="675"
              alt={`${c.heroAltPrefix} ${post.title}`}
              loading="eager"
              decoding="async"
            />
          )}
          <div class="post-body" set:html={body} />
        </article>
        <AuthorBox lang={lang} />
        {related.length > 0 && (
          <section class="post-related" aria-labelledby="related-title">
            <h2 id="related-title">{c.relatedHeading}</h2>
            <div class="related-grid">
              {related.map((p) => <PostCard post={p} lang={lang} minRead={c.minRead} />)}
            </div>
          </section>
        )}
        <p><a href={`/${lang}/blog`}>{c.backToBlog}</a></p>
      </main>
    )}
</BaseLayout>
<style>
  .post-detail { max-width: 52rem; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; font-size: 0.9rem; opacity: 0.8; margin: 0.5rem 0 1rem; }
  .post-lede { font-size: 1.15rem; }
  .post-hero { width: 100%; height: auto; border-radius: 12px; margin: 1rem 0 2rem; }
  .post-body :global(img) { max-width: 100%; height: auto; }
  .post-body :global(pre) { overflow-x: auto; }
  .post-body :global(table) { display: block; overflow-x: auto; }
  .related-grid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); margin: 1.5rem 0; }
</style>
