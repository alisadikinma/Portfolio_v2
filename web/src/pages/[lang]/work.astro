---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard, { type ProjectCardData } from "../../components/ProjectCard.astro";
import Lightbox from "../../components/Lightbox.astro";
import { apiGet, apiGetPage } from "../../lib/api";
import { LANGS, type Lang } from "../../lib/i18n";
import { awardHref, photosFromGalleries, type Photo } from "../../lib/career";
import { awardResultKind, organizerName } from "../../lib/award";
import { SITE, breadcrumb, collectionPage, graph, personNode, webPageNode, websiteNode } from "../../lib/schema";
import { ANCHORS, TITLES } from "../../../scripts/seo-gate.config.mjs";
import { id } from "../../content/copy/id";
import { en } from "../../content/copy/en";

const raw = Astro.params.lang;
if (!(LANGS as readonly string[]).includes(raw ?? "")) {
  return new Response(null, { status: 404 });
}
const lang = raw as Lang;
const copy = lang === "id" ? id : en;
const c = copy.work;
const a = copy.award;
const path = `/${lang}/work`;
const url = SITE + path;
const title = (TITLES as Record<string, string>)[path];

const TABS = ["projects", "awards", "gallery"] as const;
type Tab = (typeof TABS)[number];
const q = Astro.url.searchParams.get("tab") ?? "";
const tab: Tab = (TABS as readonly string[]).includes(q) ? (q as Tab) : "projects";

const str = (v: unknown): string => (typeof v === "string" ? v.trim() : "");

interface AwardCard { title: string; organizer: string; when: string; result: string; href: string | null }
interface GalleryCard { title: string; meta: string; photos: Photo[] }
const projects: ProjectCardData[] = [];
const awards: AwardCard[] = [];
const galleries: GalleryCard[] = [];
let failed = false;

// Only the active tab's source is fetched; a failing source never takes the tab navigation down.
try {
  if (tab === "projects") {
    const PER_PAGE = 50;
    for (let page = 1; page <= 10; page++) {
      const res = await apiGetPage<Record<string, unknown>>(`/projects?per_page=${PER_PAGE}&page=${page}`, { lang });
      if (!res || !Array.isArray(res.data)) {
        failed = page === 1;
        break;
      }
      for (const p of res.data) {
        if (!p || typeof p.slug !== "string" || p.slug === "" || typeof p.title !== "string" || p.title.trim() === "") continue;
        projects.push({
          slug: p.slug,
          title: p.title,
          description: typeof p.description === "string" ? p.description : "",
          category: typeof p.category === "string" ? p.category.trim() : "",
          image: typeof p.featured_image === "string" && p.featured_image !== "" ? p.featured_image : null,
        });
      }
      const last = Number((res.meta as { last_page?: unknown } | null)?.last_page ?? 1);
      if (!(last > page)) break;
    }
  } else if (tab === "awards") {
    const list = await apiGet<Record<string, unknown>[]>("/awards?limit=50", { lang });
    if (!Array.isArray(list)) failed = true;
    else {
      for (const w of list) {
        const t = str(w?.title);
        if (t === "") continue;
        const kind = awardResultKind(t);
        awards.push({
          title: t,
          organizer: organizerName(str(w.organization)),
          when: str(w.received_at),
          result: kind === "first" ? a.resultFirst : kind === "finalist" ? a.resultFinalist : kind === "fellow" ? a.resultFellow : kind === "attendee" ? a.resultAttendee : "",
          href: awardHref(w, lang),
        });
      }
    }
  } else {
    const list = await apiGet<Record<string, unknown>[]>("/galleries?limit=50", { lang });
    if (!Array.isArray(list)) failed = true;
    else {
      for (const g of list) {
        const t = str(g?.title);
        const photos = photosFromGalleries([g]).photos;
        if (t === "" || photos.length === 0) continue;
        galleries.push({ title: t, meta: [str(g.company), str(g.period)].filter(Boolean).join(" · "), photos });
      }
    }
  }
} catch {
  failed = true;
}
if (failed) {
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "120");
}

const THUMBS = 12;
const rotated = (all: Photo[], i: number) => JSON.stringify([...all.slice(i), ...all.slice(0, i)].map((p) => p.full));
const tabHref = (t: Tab) => `${path}?tab=${t}`;
const tabLabel: Record<Tab, string> = { projects: c.tabProjects, awards: c.tabAwards, gallery: c.tabGallery };
const hasPhotos = tab === "gallery" && galleries.length > 0;

const items =
  tab === "projects"
    ? projects.map((p) => ({ name: p.title, url: `${SITE}/${lang}/projects/${encodeURIComponent(p.slug)}` }))
    : tab === "awards"
      ? awards.filter((w) => w.href !== null).map((w) => ({ name: w.title, url: SITE + (w.href as string) }))
      : [];
const jsonld = graph(
  personNode(),
  websiteNode(),
  webPageNode({ url, lang, name: title, description: c.metaDescription }),
  collectionPage({ url, lang, name: title, description: c.metaDescription, items }),
  breadcrumb([
    { name: c.breadcrumbHome, url: `${SITE}/${lang}` },
    { name: c.breadcrumbWork, url },
  ]),
);
---
<BaseLayout title={title} description={c.metaDescription} path={path} lang={lang} jsonld={jsonld}>
  <main class="wrap work-page">
    <h1>{c.h1}</h1>
    <p>{c.intro}</p>
    <nav class="work-tabs" aria-label={c.tabsLabel}>
      {TABS.map((t) => (
        <a href={tabHref(t)} aria-current={t === tab ? "page" : undefined}>{tabLabel[t]}</a>
      ))}
    </nav>
    {failed ? (
      <p class="work-note" role="status">{c.unavailable}</p>
    ) : tab === "projects" ? (
      projects.length > 0 ? (
        <>
          <div class="work-grid">
            {projects.map((p) => <ProjectCard project={p} lang={lang} readMore={c.readMore} />)}
          </div>
          <p class="work-more"><a href={`/${lang}/projects`}>{c.allProjects}</a></p>
        </>
      ) : (
        <p class="work-note" role="status">{c.empty}</p>
      )
    ) : tab === "awards" ? (
      awards.length > 0 ? (
        <ul class="work-awards">
          {awards.map((w) => (
            <li class="award-card">
              <h2>{w.href ? <a href={w.href}>{w.title}</a> : w.title}</h2>
              <p class="award-card-meta">{[w.organizer, w.when].filter(Boolean).join(" · ")}</p>
              {w.result && <p class="award-card-result">{w.result}</p>}
              {w.href && <a class="award-card-more" href={w.href}>{c.awardOpen}</a>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="work-note" role="status">{c.emptyAwards}</p>
      )
    ) : galleries.length > 0 ? (
      <div class="work-galleries">
        {galleries.map((g) => (
          <section>
            <h2>{g.title}</h2>
            <p class="award-card-meta">{[g.meta, c.photosCount.replace("{n}", String(g.photos.length))].filter(Boolean).join(" · ")}</p>
            <ul class="work-photos">
              {g.photos.slice(0, THUMBS).map((p, i) => (
                <li>
                  <button
                    type="button"
                    class="work-thumb"
                    data-lightbox=""
                    data-lightbox-title={g.title}
                    data-lightbox-items={rotated(g.photos, i)}
                    aria-label={c.photoOpen.replace("{n}", String(i + 1)).replace("{title}", g.title)}
                  >
                    <img
                      src={p.src}
                      srcset={p.srcset}
                      sizes={p.srcset ? "(min-width: 860px) 25vw, 50vw" : undefined}
                      alt={c.photoAlt.replace("{title}", g.title).replace("{n}", String(i + 1))}
                      width="640"
                      height="480"
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                </li>
              ))}
            </ul>
            {g.photos.length > THUMBS && <p class="award-card-meta">{c.morePhotos.replace("{n}", String(g.photos.length - THUMBS))}</p>}
          </section>
        ))}
      </div>
    ) : (
      <p class="work-note" role="status">{c.emptyGallery}</p>
    )}
    <p class="work-more">{c.closingLead} <a href={`/${lang}/about`}>{c.aboutLink}</a> {c.closingMid} <a href={`/${lang}/contact`}>{c.contactLink}</a>.</p>
  </main>
  {hasPhotos && <Lightbox lang={lang} />}
</BaseLayout>
<style>
  .work-page { padding-block: 64px; }
  .work-tabs { display: flex; flex-wrap: wrap; gap: 10px; margin: 28px 0; }
  .work-tabs a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border: 1px solid var(--border-emphasis); border-radius: var(--radius-md); text-decoration: none; color: var(--text-primary); }
  .work-tabs a[aria-current="page"] { background: var(--accent-primary); color: var(--bg-deep); border-color: transparent; }
  .work-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
  .work-more { margin-block: 24px; }
  .work-note { color: var(--text-secondary); }
  .work-awards { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
  .award-card { padding: 20px; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); display: grid; gap: 8px; align-content: start; }
  .award-card h2 { font: 600 20px/1.3 var(--font-display); }
  .award-card h2 a { color: var(--text-primary); text-decoration: none; }
  .award-card h2 a:hover { color: var(--accent-primary); }
  .award-card-meta { color: var(--text-secondary); margin: 0; }
  .award-card-result { margin: 0; color: var(--accent-primary); font-weight: 500; }
  .award-card-more { color: var(--accent-primary); font-weight: 500; }
  .work-galleries { display: grid; gap: 40px; }
  .work-photos { list-style: none; padding: 0; margin-top: 16px; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
  .work-thumb { all: unset; box-sizing: border-box; display: block; width: 100%; cursor: pointer; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border-subtle); }
  .work-thumb:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 3px; }
  .work-thumb img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
</style>
