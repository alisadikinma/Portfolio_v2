---
import type { Lang } from "../../lib/i18n";
import { id } from "../../content/copy/id";
import { en } from "../../content/copy/en";

interface Props { lang: Lang }
const { lang } = Astro.props;
const w = (lang === "id" ? id : en).whoIAm;
// Dofollow backlinks to INDUSIA.ai: no rel attribute (spec backlink table).
const base = lang === "id" ? "https://indusia.ai/id/" : "https://indusia.ai/";
// Same file as the hero LCP image, so the browser already has it cached.
---
<section class="sec" id="tentang">
  <div class="wrap who">
    <h2 class="who-h">{w.h2}</h2>
    <div class="body who-body">
      <p><strong>{w.p1Strong}</strong>{w.p1Rest}</p>
      <p>{w.p2Lead}<a href={`${base}ai-vision/`}>{w.visionLink}</a>, <a href={`${base}ai-fleet-transportation/`}>{w.fleetLink}</a>, <a href={`${base}ai-assistant/`}>{w.chatbotLink}</a>{w.p2Mid}<a href={base}>{w.companyLink}</a>{w.p2End}</p>
    </div>
    <img class="who-portrait" src="/images/ali-sadikin-ma-pakar-ai-indonesia.jpg" alt={w.portraitAlt}
      width="1200" height="1200" loading="lazy" decoding="async" />
  </div>
</section>

