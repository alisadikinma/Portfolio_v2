---
import type { Lang } from "../../lib/i18n";
import { id } from "../../content/copy/id";
import { en } from "../../content/copy/en";
import { imageDimensions } from "../../lib/image-dims";
import { STAGE_AWARD_IDS, awardHref, loadAwardPhotos, loadAwardSlugs, type Photos } from "../../lib/career";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = (lang === "id" ? id : en).stages;
const n = (count: number) => s.photos.replace("{n}", String(count));

const [photoRes, slugRes] = await Promise.all([
  Promise.allSettled(STAGE_AWARD_IDS.map((a) => loadAwardPhotos(a, lang))),
  loadAwardSlugs(lang),
]);
const photos = new Map<number, Photos | null>(
  STAGE_AWARD_IDS.map((a, i) => [a, photoRes[i].status === "fulfilled" ? photoRes[i].value : null]),
);

const cards = [
  { award: 13, main: true, yr: s.demoDayYear, title: s.demoDayTitle, desc: s.demoDayDesc, lock: s.demoDayLock, lockSm: false, alt: s.demoDayAlt },
  { award: 10, main: false, yr: s.unctadYear, title: s.unctadTitle, desc: "", lock: "", lockSm: false, alt: s.unctadAlt },
  { award: 11, main: false, yr: s.grindYear, title: s.grindTitle, desc: "", lock: "", lockSm: false, alt: s.grindAlt },
  { award: 7, main: false, yr: s.nextdevYear, title: s.nextdevTitle, desc: "", lock: s.nextdevLock, lockSm: true, alt: s.nextdevAlt },
  { award: 8, main: false, yr: s.fenoxYear, title: s.fenoxTitle, desc: "", lock: s.fenoxLock, lockSm: true, alt: s.fenoxAlt },
];
const dimList = await Promise.all(cards.map((c) => { const u = photos.get(c.award)?.cover; return u ? imageDimensions(u) : null; }));
---
<section class="sec" id="panggung" aria-labelledby="stages-h">
  <div class="wrap">
    <div class="sec-head"><h2 id="stages-h">{s.h2}</h2><p class="lead">{s.lead}</p></div>
    <ul class="bento">
      {cards.map((c, i) => {
        const p = photos.get(c.award) ?? null;
        const urls = p?.urls ?? [];
        const cover = p?.cover ?? null;
        const d = dimList[i];
        const href = awardHref({ slug: slugRes.get(c.award) }, lang);
        const open = s.openGallery.replace("{title}", c.title);
        const trigger = { "data-lightbox": "", "data-lightbox-title": c.title, "data-lightbox-items": JSON.stringify(urls) };
        const Tag = href ? "a" : urls.length > 0 ? "button" : "div";
        const tagAttrs = href ? { href } : urls.length > 0 ? { type: "button" as const, "aria-label": open, ...trigger } : {};
        return (
          <li class:list={["bt-item", { "bt-main": c.main }]}>
            <Tag class="bt-card" {...tagAttrs}>
              {cover && <img src={cover} alt={c.alt} loading="lazy" decoding="async" width={d?.w} height={d?.h} />}
              {c.lock && <span class:list={["bt-lock", { "gold-sm": c.lockSm }]} aria-hidden="true"><b>{c.lock}</b></span>}
              <span class="bt-cap">
                <span class="yr">{c.yr}</span>
                <strong>{c.title}</strong>
                {c.desc && <span>{c.desc}</span>}
                {urls.length > 0 && <em>{n(urls.length)}</em>}
              </span>
            </Tag>
            {href && urls.length > 0 && (
              <button type="button" class="bt-open" aria-label={open} {...trigger}>{n(urls.length)}</button>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>
<style>
  .bt-item { position: relative; }
  /* same card box for the three variants (button is styled globally; a and div are not) */
  .bt-card { box-sizing: border-box; cursor: pointer; position: relative; display: block; width: 100%; height: 100%; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border-subtle); background: var(--bg-elevated); color: inherit; text-decoration: none; }
  div.bt-card { cursor: default; }
  a.bt-card::after, div.bt-card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,18,32,0) 38%, rgba(10,18,32,.75) 68%, rgba(10,18,32,.97) 100%); }
  a.bt-card:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 3px; }
  a.bt-card:hover :global(img) { transform: scale(1.04); }
  /* separate gallery trigger next to an award-page link (no nested interactive elements) */
  .bento .bt-open { all: unset; box-sizing: border-box; cursor: pointer; position: absolute; z-index: 3; top: 12px; left: 12px; width: auto; height: auto; padding: 7px 10px; border-radius: 6px; font: 500 12px/1 var(--font-mono); color: var(--text-primary); background: rgba(10,18,32,.78); border: 1px solid var(--border-emphasis); }
  .bento .bt-open::after { display: none; }
  .bento .bt-open:hover { border-color: var(--accent-primary); }
  .bento .bt-open:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 2px; }
</style>
