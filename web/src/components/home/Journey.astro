---
import { Image, getImage } from "astro:assets";
import type { Lang } from "../../lib/i18n";
import { id } from "../../content/copy/id";
import { en } from "../../content/copy/en";
import { ANCHORS } from "../../../scripts/seo-gate.config.mjs";
import {
  GALLERIES_MARLIN, GALLERY_SATNUSA, GALLERY_SINGAPORE, LIGHTBOX_WIDTH, THUMB_MIN_WIDTH, loadGallery, type Photos,
} from "../../lib/career";
import marlinCover from "../../assets/career-marlin.jpg"; // first lightbox photo of the Marlin chapter
// The indusia.ai/founder illustration with its white page removed (transparent), so it sits on
// the site's dark theme. No text in it, so it works for both languages.
import journeyIllus from "../../assets/founder-journey-night.webp";

interface Props { lang: Lang }
const { lang } = Astro.props;
const j = (lang === "id" ? id : en).journey;
const a = ANCHORS[lang];
const n = (count: number) => j.photos.replace("{n}", String(count));

const ids = [GALLERY_SINGAPORE, ...GALLERIES_MARLIN, GALLERY_SATNUSA];
const settled = await Promise.allSettled(ids.map((g) => loadGallery(g, lang)));
const got = new Map<number, Photos | null>(
  ids.map((g, i) => [g, settled[i].status === "fulfilled" ? settled[i].value : null]),
);
const singapore = got.get(GALLERY_SINGAPORE) ?? null;
const satnusa = got.get(GALLERY_SATNUSA) ?? null;
const marlinParts = GALLERIES_MARLIN.map((g) => got.get(g) ?? null);
const marlinFull = (await getImage({ src: marlinCover, width: LIGHTBOX_WIDTH, format: "webp" })).src;
// Same file as the <img>: the light sweep is masked to the islands' shape.
const illusMask = (await getImage({ src: journeyIllus, width: 1280, format: "webp" })).src;
const marlinThumb = (await getImage({ src: marlinCover, width: THUMB_MIN_WIDTH, format: "webp" })).src;
const marlinUrls = [marlinFull, ...marlinParts.flatMap((p) => p?.photos.map((x) => x.full) ?? [])];
const marlinThumbs = [marlinThumb, ...marlinParts.flatMap((p) => p?.photos.map((x) => x.thumb) ?? [])];
// A count is only honest when every source gallery loaded.
const marlinComplete = marlinParts.every((p) => p !== null);

const chapters = [
  { key: "singapore", gallery: String(GALLERY_SINGAPORE), items: singapore?.photos.map((x) => x.full) ?? [], thumbs: singapore?.photos.map((x) => x.thumb) ?? [], count: singapore?.photos.length ?? 0, yr: j.singaporeYear, role: j.singaporeRole, org: j.singaporeOrg, title: j.singaporeRole, note: j.singaporeNote },
  { key: "marlin", gallery: "marlin", items: marlinUrls, thumbs: marlinThumbs, count: marlinComplete ? marlinUrls.length : 0, yr: j.marlinYear, role: j.marlinRole, org: j.marlinOrg, title: j.marlinOrg, note: j.marlinNote },
  { key: "satnusa", gallery: String(GALLERY_SATNUSA), items: satnusa?.photos.map((x) => x.full) ?? [], thumbs: satnusa?.photos.map((x) => x.thumb) ?? [], count: satnusa?.photos.length ?? 0, yr: j.satnusaYear, role: j.satnusaRole, org: j.satnusaOrg, title: j.satnusaOrg, note: j.satnusaNote },
];
---
<section class="sec" id="perjalanan" aria-labelledby="journey-h">
  <div class="wrap">
    <div class="sec-head"><h2 id="journey-h">{j.h2}</h2><p class="lead">{j.lead}</p></div>
    {/* One board: the islands on top, each chapter's text right under its island.
        Island and caption open the same gallery; hovering one lights up the other. */}
    <div class="jr-board">
      <figure class="jr-illus" style={`--jr-mask:url(${illusMask})`}>
        <div class="jr-art">
          <Image src={journeyIllus} widths={[640, 960, 1280, 1580]} sizes="(max-width: 1200px) 100vw, 1200px"
            alt={j.illusAlt} loading="lazy" decoding="async" format="webp" />
          <span class="jr-sweep" aria-hidden="true"></span>
        {chapters.map((c, i) => c.items.length > 0 && (
          <button class={`jr-spot s${i + 1}`} type="button" data-hotspot={c.key} data-lightbox data-lightbox-title={c.title}
            data-lightbox-items={JSON.stringify(c.items)} data-lightbox-thumbs={JSON.stringify(c.thumbs)} aria-label={j.illusOpen.replace("{name}", c.title)}></button>
        ))}
        <a class="jr-spot s4" data-hotspot="indusia" href={a.hero.href} aria-label={j.illusIndusia}></a>
        </div>
      </figure>
      <ol class="journey">
        {chapters.map((c, i) => {
          const Tag = c.items.length > 0 ? "button" : "div";
          const attrs = c.items.length > 0
            ? { type: "button" as const, "data-career": c.gallery, "data-lightbox": "", "data-lightbox-title": c.title, "data-lightbox-items": JSON.stringify(c.items), "data-lightbox-thumbs": JSON.stringify(c.thumbs) }
            : {};
          return (
            <li class={`c${i + 1}`}>
              <Tag class="jr-card" {...attrs}>
                <span class="jr-yr">{c.yr}</span>
                <strong>{c.role}</strong>
                <span class="jr-org">{c.org}</span>
                <span class="jr-note">{c.note}</span>
                {c.count > 0 && <em class="jr-count">{n(c.count)}</em>}
                {c.items.length > 0 && <span class="sr"> · {j.openHint}</span>}
              </Tag>
            </li>
          );
        })}
        <li class="c4 jr-now">
          <div class="jr-card">
            <span class="jr-yr">{j.indusiaYear}<em class="jr-live">{j.indusiaNow}</em></span>
            <strong>{j.indusiaRole}</strong>
            <span class="jr-org">{j.indusiaOrg}</span>
            <p class="jr-note"><a href={a.vision.href}>{a.vision.anchor}</a>{j.indusiaNoteMid1}<a href={a.fleet.href}>{a.fleet.anchor}</a>{j.indusiaNoteMid2}<a href={a.chatbot.href}>{a.chatbot.anchor}</a>{j.indusiaNoteEnd}</p>
            <a class="jr-cta" href={a.hero.href}>{j.indusiaCta}</a>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>
