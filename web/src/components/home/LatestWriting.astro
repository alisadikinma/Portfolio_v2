---
import type { Lang } from "../../lib/i18n";
import { apiGet } from "../../lib/api";
import { id } from "../../content/copy/id";
import { en } from "../../content/copy/en";

interface Article { slug?: string | null; title?: string | null; published_at?: string | null }
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (lang === "id" ? id : en).latestWriting;

let articles: Article[] = [];
try {
  const data = await apiGet<{ latest_articles?: Article[] }>("/homepage/featured", { lang });
  if (data && Array.isArray(data.latest_articles)) articles = data.latest_articles;
} catch (e) {
  console.warn("[home] latest articles unavailable", (e as Error).message);
}
const fmt = new Intl.DateTimeFormat(lang === "id" ? "id-ID" : "en-US", { dateStyle: "medium", timeZone: "UTC" });
const items = articles
  .filter((a) => a.slug && a.title)
  .slice(0, 3)
  .map((a) => {
    const d = a.published_at ? new Date(a.published_at) : null;
    const ok = d !== null && !Number.isNaN(d.getTime());
    return {
      href: `/${lang}/blog/${encodeURIComponent(a.slug as string)}`,
      title: a.title as string,
      iso: ok ? d.toISOString() : "",
      label: ok ? fmt.format(d) : "",
    };
  });
---
{items.length > 0 && (
  <section class="sec" id="tulisan" aria-labelledby="tulisan-h">
    <div class="wrap">
      <div class="sec-head"><h2 id="tulisan-h">{t.h2}</h2></div>
      <ul class="posts">
        {items.map((i) => (
          <li><a href={i.href}><h3>{i.title}</h3>{i.iso && <time datetime={i.iso}>{i.label}</time>}</a></li>
        ))}
      </ul>
      <p style="margin-top:24px"><a href={`/${lang}/blog`}>{t.all}</a></p>
    </div>
  </section>
)}
