---
import type { Lang } from "../lib/i18n";
import { id } from "../content/copy/id";
import { en } from "../content/copy/en";

interface Props {
  lang: Lang;
  /** wa.me link built from settings site.contact_phone by the page; omit/empty hides the CTA. */
  wa?: string;
}
const { lang, wa = "" } = Astro.props;
const h = (lang === "id" ? id : en).hero;
const PHOTO = "/images/ali-sadikin-ma-pakar-ai-indonesia.jpg";
const founderHref = lang === "id" ? "https://indusia.ai/id/" : "https://indusia.ai/";
---
<section class="hx" data-hero data-photo={PHOTO} aria-labelledby="hero-h1">
  <div class="hx-cloud" data-cloud aria-hidden="true"></div>
  <img class="hx-fallback" src={PHOTO} alt={h.imgAlt} width="1200" height="1200" fetchpriority="high" decoding="async" />
  <div aria-hidden="true">
    <span class="det" data-box="0.33,0.12,0.34,0.40"><b>{h.det1}</b></span>
    <span class="det win r" data-box="0.53,0.66,0.18,0.09"><b>{h.det2}</b></span>
    <span class="det side" data-box="0.10,0.74,0.28,0.13"><b>{h.det3}</b></span>
    <span class="det r side" data-box="0.66,0.50,0.24,0.12"><b>{h.det4}</b></span>
  </div>
  <div class="wrap hx-text">
    <h1 id="hero-h1"><span class="hx-h1-name">{h.h1Name}</span> {h.h1Title}</h1>
    <p class="hx-lead" id="hero-lead">{h.leadBefore}<a href={founderHref}>{h.leadLinkText}</a>{h.leadAfter}</p>
    <button type="button" class="hx-more" hidden aria-expanded="false" aria-controls="hero-lead" data-more={h.more} data-less={h.less}>{h.more}</button>
    <div class="hero-ctas">
      {wa !== "" && <a class="btn btn-primary" href={wa}>{h.ctaWhatsapp}</a>}
      <a class="btn btn-ghost" href="#layanan">{h.ctaServices}</a>
    </div>
  </div>
  <div class="hx-hud" aria-hidden="true">
    <span><span class="live"></span><span data-status data-busy={h.statusBusy} data-done={h.statusDone}>{h.statusDone}</span></span>
    <span class="r"><span>{h.hudProducts} <b data-count="56">56</b></span><span>{h.hudYears} <b data-count="17">17</b></span></span>
  </div>
</section>
<script>
  import { initHero } from "../scripts/hero-cloud";
  initHero();
</script>
