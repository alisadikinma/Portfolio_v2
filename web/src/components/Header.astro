---
import { alternates, localizedPath, type Lang } from "../lib/i18n";
import { waLink } from "../lib/whatsapp";
import { id } from "../content/copy/id";
import { en } from "../content/copy/en";

interface Props {
  lang: Lang;
  path: string;
  /** Home page: nav anchors stay in-page. Elsewhere they point to /{lang}/#id. */
  home?: boolean;
  /** Languages this page exists in (default both): the switch link to a missing one is hidden. */
  availableLangs?: Lang[];
}
const { lang, path, home = false, availableLangs } = Astro.props;
const otherLang: Lang = lang === "id" ? "en" : "id";
const canSwitch = !availableLangs || availableLangs.includes(otherLang);
const c = lang === "id" ? id : en;
const alts = alternates(path);
const homePath = `/${lang}`;
const spy = (hash: string) => (home ? hash : `${homePath}/${hash}`);
const wa = await waLink(lang);
// Native names, the same on both language versions (a reader looks for their own language).
const LANG_NAME: Record<Lang, string> = { id: "Bahasa Indonesia", en: "English" };
const order: Lang[] = ["en", "id"]; // same order as the live site: US, then ID
// "Konsultasi via WhatsApp": phones show only the last word (CSS hides .long under 520px).
const cta = c.nav.ctaWhatsapp;
const cut = cta.lastIndexOf(" ");
const ctaLead = cut > 0 ? cta.slice(0, cut + 1) : "";
const ctaLast = cut > 0 ? cta.slice(cut + 1) : cta;
---
<header class="site-head">
  <div class="wrap">
    <a class="brand" href={homePath}>Ali Sadikin Ma <span>/ AI</span></a>
    <nav class="nav" aria-label={c.nav.ariaMain}>
      <a href={spy("#tentang")} data-spy>{c.nav.about}</a>
      <a href={spy("#perjalanan")} data-spy>{c.nav.journey}</a>
      <a href={spy("#layanan")} data-spy>{c.nav.services}</a>
      <a href={localizedPath(`/${lang}/pelatihan-ai`, lang)}>{c.nav.training}</a>
      <a href={localizedPath(`/${lang}/pembicara-ai`, lang)}>{c.nav.speaker}</a>
      <a href={spy("#tulisan")} data-spy>{c.nav.blog}</a>
    </nav>
    <div class="lang-sw" role="group" aria-label={c.nav.ariaLang}>
      {order.map((l) => {
        const flag = l === "id"
          ? <svg viewBox="0 0 3 2" width="22" height="15" aria-hidden="true"><rect width="3" height="1" fill="#CE1126"/><rect y="1" width="3" height="1" fill="#FFF"/></svg>
          : <svg viewBox="0 0 19 10" width="22" height="15" aria-hidden="true"><rect width="19" height="10" fill="#FFF"/><path d="M0 0h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19V10H0z" fill="#B22234"/><rect width="7.6" height="5.39" fill="#3C3B6E"/></svg>;
        if (l === lang) return <span class="flag is-on" aria-current="true" title={LANG_NAME[l]}>{flag}<span class="sr-only">{LANG_NAME[l]}</span></span>;
        return canSwitch ? <a class="lang flag" href={alts[l]} hreflang={l} lang={l} title={LANG_NAME[l]}>{flag}<span class="sr-only">{LANG_NAME[l]}</span></a> : null;
      })}
    </div>
    {wa !== "" && <a class="btn btn-primary" href={wa} aria-label={cta}>{ctaLead && <span class="long">{ctaLead}</span>}{ctaLast}</a>}
  </div>
</header>
<script>
  import { initScrollspy } from "../scripts/scrollspy";
  initScrollspy();
</script>
