---
import type { Lang } from "../lib/i18n";
import { loadLatestArticles, plainText } from "../lib/latest";
import { id } from "../content/copy/id";
import { en } from "../content/copy/en";

interface Props { lang: Lang }
const { lang } = Astro.props;
const n = (lang === "id" ? id : en).newsletter;
// The preview is built from the real latest posts (same cached request as "Latest writing").
// It is a picture of the email, not navigation: aria-hidden, no links.
const posts = await loadLatestArticles(lang, 3);
const subject = n.previewSubject.replace("{n}", String(posts.length));
---
<section class="sec alt nl" aria-labelledby="news-h">
  <div class="wrap nl-grid">
    <div class="nl-copy">
      <h2 id="news-h">{n.h2}</h2>
      <p class="muted nl-lead">{n.lead}</p>
      <form
        class="form nl-form"
        novalidate
        data-newsletter
        data-endpoint="/api/newsletter/subscribe"
        data-source="homepage_join"
        data-sending={n.sending}
        data-ok={n.ok}
        data-rate={n.rate}
        data-network={n.network}
        data-dup={n.dup}
        data-server={n.server}
        data-required={n.required}
        data-invalid-email={n.invalidEmail}
        data-invalid-wa={n.invalidWa}
      >
        <div class="two">
          <div class="field">
            <label for="nl-name">{n.nameLabel}</label>
            <input id="nl-name" name="name" type="text" autocomplete="name" maxlength="120" required aria-describedby="nl-name-err" />
            <span class="err" id="nl-name-err" data-err="name"></span>
          </div>
          <div class="field">
            <label for="nl-email">{n.emailLabel}</label>
            <input id="nl-email" name="email" type="email" autocomplete="email" maxlength="255" required aria-describedby="nl-email-err" />
            <span class="err" id="nl-email-err" data-err="email"></span>
          </div>
        </div>
        <div class="field">
          <label for="nl-wa">{n.waLabel}</label>
          <input id="nl-wa" name="whatsapp" type="tel" autocomplete="tel" inputmode="tel" placeholder="+628123456789" required aria-describedby="nl-wa-help nl-wa-err" />
          <span class="help" id="nl-wa-help">{n.waHelp}</span>
          <span class="err" id="nl-wa-err" data-err="whatsapp"></span>
        </div>
        <div><button class="btn btn-primary" type="submit">{n.cta}</button></div>
        <p data-status role="status" aria-live="polite"></p>
      </form>
    </div>
    {posts.length > 0 && (
      <div class="nl-visual">
        <aside class="mail" data-mail-preview aria-hidden="true">
          <div class="mail-bar"><span></span><span></span><span></span></div>
          <div class="mail-head">
            <img class="mail-ava" src="/images/ali-sadikin-ma-pakar-ai-indonesia.jpg" width="80" height="80" alt="Ali Sadikin Ma" loading="lazy" decoding="async" />
            <div class="mail-from">
              <strong>{n.previewFrom}</strong>
              <span>{n.previewTo}</span>
            </div>
            <span class="mail-when">{n.previewWhen}</span>
          </div>
          <p class="mail-subj">{subject}</p>
          <ol class="mail-list">
            {posts.map((p, i) => (
              <li>
                {p.img
                  ? <img src={p.img.src} srcset={p.img.srcset} sizes={p.img.srcset ? "120px" : undefined} width="120" height="68" alt={plainText(p.title)} loading="lazy" decoding="async" />
                  : <span class="mail-ph"></span>}
                <span class="mail-t"><em>{String(i + 1).padStart(2, "0")}</em>{p.title}</span>
              </li>
            ))}
          </ol>
          <p class="mail-reply">{n.previewReply}</p>
        </aside>
        <p class="nl-note">{n.previewNote}</p>
      </div>
    )}
  </div>
</section>
<script>
  import { initAllNewsletterForms } from "../scripts/newsletter-form";
  initAllNewsletterForms();
</script>
