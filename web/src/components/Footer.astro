---
import type { Lang } from "../lib/i18n";
import { SAME_AS } from "../lib/schema";
import SocialLink from "./SocialLink.astro";
import { id } from "../content/copy/id";
import { en } from "../content/copy/en";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = lang === "id" ? id : en;
const founderHref = lang === "id" ? "https://indusia.ai/id/" : "https://indusia.ai/";
const social = (host: string) => SAME_AS.find((u) => u.includes(host)) ?? "";
---
<footer class="foot">
  <div class="wrap">
    <span>{c.footer.copyright} · <a href={founderHref} target="_blank">Founder INDUSIA.ai</a></span>
    <nav aria-label={c.footer.ariaSocial}>
      {social("linkedin") !== "" && <SocialLink href={social("linkedin")} label={c.footer.linkedin} />}
      {social("instagram") !== "" && <SocialLink href={social("instagram")} label={c.footer.instagram} />}
      {social("youtube") !== "" && <SocialLink href={social("youtube")} label={c.footer.youtube} />}
      {social("tiktok") !== "" && <SocialLink href={social("tiktok")} label={c.footer.tiktok} />}
      <a href={`/${lang}/faq`}>{c.footer.faq}</a>
    </nav>
  </div>
</footer>
