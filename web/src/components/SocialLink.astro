---
// Social profile as an icon-only link (Ali 2026-11-09): the label stays as aria-label/title for
// screen readers and tooltips. External, so it opens in a new tab.
interface Props { href: string; label: string; rel?: string }
const { href, label, rel = "noopener" } = Astro.props;
const host = (() => { try { return new URL(href).hostname.replace(/^www\./, ""); } catch { return ""; } })();
const kind = ["linkedin", "instagram", "youtube", "tiktok", "threads", "github"].find((k) => host.includes(k)) ?? "link";
---
<a class="soc" href={href} target="_blank" rel={rel} aria-label={label} title={label}>
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {kind === "linkedin" && <><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></>}
    {kind === "instagram" && <><rect x="2" y="2" width="20" height="20" rx="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><path d="M17.5 6.5h.01" /></>}
    {kind === "youtube" && <><path d="M2.5 17a24.1 24.1 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.6 49.6 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.1 24.1 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.6 49.6 0 0 1-16.2 0A2 2 0 0 1 2.5 17" /><path d="m10 15 5-3-5-3z" /></>}
    {kind === "tiktok" && <path d="M9 12a4 4 0 1 0 4 4V3c.5 2.6 2.4 4.6 5 5" />}
    {kind === "threads" && <path d="M16.5 11.5c-.3-2.6-2-4-4.5-4-2.8 0-4.5 2-4.5 4.5s1.7 4.5 4.5 4.5c2 0 3.2-1 3.6-2.7.5-2.2-.6-3.8-3-3.8-1.8 0-2.6 1-2.6 2.1 0 1.2 1 1.9 2.3 1.9 3.3 0 5.7-1.6 5.7-5 0-3.6-2.8-6-6-6-4 0-7 3-7 7s3 7 7 7c2 0 3.5-.6 4.6-1.6" />}
    {kind === "github" && <><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></>}
    {kind === "link" && <><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" /><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></>}
  </svg>
</a>
