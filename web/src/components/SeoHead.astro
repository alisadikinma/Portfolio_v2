---
import { alternates, type Lang } from "../lib/i18n";
import { SITE, PORTRAIT_URL, jsonLdString, type Node } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  path: string;
  lang: Lang;
  jsonld: Node;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  preloadImage?: string;
  type?: "website" | "article";
}

const { title, description, path, lang, jsonld, image, imageWidth, imageHeight, preloadImage, type = "website" } = Astro.props;
const abs = (p: string) => SITE + p;
const alts = alternates(path);
// Canonical must equal the self-referencing hreflang (normalized path).
const canonical = abs(alts[lang]);
const ogImage = image ?? PORTRAIT_URL;
// Portrait is 1200x1200; declare size only for it or when the caller states it.
const w = imageWidth ?? (image ? undefined : 1200);
const h = imageHeight ?? (image ? undefined : 1200);
const locale = lang === "id" ? "id_ID" : "en_US";
const altLocale = lang === "id" ? "en_US" : "id_ID";
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index,follow" />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="id" href={abs(alts.id)} />
<link rel="alternate" hreflang="en" href={abs(alts.en)} />
<link rel="alternate" hreflang="x-default" href={abs(alts["x-default"])} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Ali Sadikin Ma" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{w && <meta property="og:image:width" content={String(w)} />}
{h && <meta property="og:image:height" content={String(h)} />}
<meta property="og:locale" content={locale} />
<meta property="og:locale:alternate" content={altLocale} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
<script type="application/ld+json" set:html={jsonLdString(jsonld)}></script>
