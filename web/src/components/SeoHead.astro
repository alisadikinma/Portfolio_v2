---
import { alternates, withAltPaths, type Lang } from "../lib/i18n";
import { SITE, PORTRAIT_URL, jsonLdString, type Node } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  path: string;
  lang: Lang;
  jsonld: Node;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  preloadImage?: string;
  type?: "website" | "article";
  /** Paginated lists: site paths (may carry ?page=N) for rel=prev / rel=next. */
  prev?: string;
  next?: string;
  /** Thin pages (e.g. empty category): robots noindex, follow instead of index,follow. */
  noindex?: boolean;
  /** Languages this page exists in (default both). A missing one gets no hreflang alternate. */
  availableLangs?: Lang[];
  /** Per-language paths when they differ by more than the prefix (e.g. blog posts with a slug per language). */
  altPaths?: Partial<Record<Lang, string>>;
}

const { title, description, path, lang, jsonld, image, imageWidth, imageHeight, preloadImage, type = "website", prev, next, noindex = false, availableLangs, altPaths } = Astro.props;
const abs = (p: string) => SITE + p;
const alts = withAltPaths(alternates(path), altPaths);
// Canonical must equal the self-referencing hreflang (normalized path).
const canonical = abs(alts[lang]);
const ogImage = image ?? PORTRAIT_URL;
// Portrait is 1200x1200; declare size only for it or when the caller states it.
const w = imageWidth ?? (image ? undefined : 1200);
const h = imageHeight ?? (image ? undefined : 1200);
const have: Lang[] = availableLangs && availableLangs.length > 0 ? availableLangs : ["id", "en"];
// x-default: English when it exists, else the language that does.
const xDefault = have.includes("en") ? alts["x-default"] : alts[have[0]];
const locale = lang === "id" ? "id_ID" : "en_US";
const altLocale = lang === "id" ? "en_US" : "id_ID";
const showAltLocale = have.includes(lang === "id" ? "en" : "id");
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex, follow" : "index,follow"} />
<link rel="canonical" href={canonical} />
{have.includes("id") && <link rel="alternate" hreflang="id" href={abs(alts.id)} />}
{have.includes("en") && <link rel="alternate" hreflang="en" href={abs(alts.en)} />}
<link rel="alternate" hreflang="x-default" href={abs(xDefault)} />
{prev && <link rel="prev" href={abs(prev)} />}
{next && <link rel="next" href={abs(next)} />}
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Ali Sadikin Ma" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{w && <meta property="og:image:width" content={String(w)} />}
{h && <meta property="og:image:height" content={String(h)} />}
<meta property="og:locale" content={locale} />
{showAltLocale && <meta property="og:locale:alternate" content={altLocale} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
<script type="application/ld+json" set:html={jsonLdString(jsonld)}></script>
