---
export interface ProjectCardData {
  slug: string;
  title: string;
  description: string;
  category: string;
  image: string | null;
}
interface Props {
  project: ProjectCardData;
  lang: string;
  readMore: string;
}
const { project, lang, readMore } = Astro.props;
const href = `/${lang}/projects/${encodeURIComponent(project.slug)}`;
---
<article class="project-card">
  <a href={href}>
    {project.image && <img src={project.image} alt={project.title} width="640" height="400" loading="lazy" decoding="async" />}
    {project.category && <span class="project-card-cat">{project.category}</span>}
    <h2>{project.title}</h2>
    {project.description && <p>{project.description}</p>}
    <span class="project-card-more">{readMore}</span>
  </a>
</article>
<style>
  .project-card a { display: grid; gap: 10px; text-decoration: none; color: var(--text-primary); height: 100%; padding: 20px; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); }
  .project-card a:hover h2 { color: var(--accent-primary); }
  .project-card img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-md); }
  .project-card h2 { font: 600 22px/1.3 var(--font-display); transition: color var(--dur-hover) var(--ease-out); }
  .project-card p { color: var(--text-secondary); margin: 0; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .project-card-cat { font: 500 13px/1 var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent-primary); }
  .project-card-more { color: var(--accent-primary); font-weight: 500; }
  /* Phones: compact row (thumb left, text right). 56 full cards made /work and /projects ~26,000px tall. */
  @media (max-width: 760px) {
    .project-card a { grid-template-columns: 96px 1fr; grid-template-rows: auto auto 1fr; column-gap: 14px; row-gap: 4px; padding: 12px; align-items: start; }
    .project-card img { grid-row: 1 / span 3; aspect-ratio: 1; border-radius: var(--radius-sm, 8px); }
    .project-card-cat { font-size: 11px; }
    .project-card h2 { font-size: 17px; line-height: 1.3; }
    .project-card p { font-size: 14px; line-height: 1.45; -webkit-line-clamp: 2; line-clamp: 2; }
    .project-card-more { display: none; }
    .project-card a > :not(img) { grid-column: 2; }
    .project-card a:not(:has(img)) { grid-template-columns: 1fr; }
    .project-card a:not(:has(img)) > * { grid-column: 1; }
  }
</style>
