---
import type { Lang } from "../lib/i18n";
import { id } from "../content/copy/id";
import { en } from "../content/copy/en";

interface Props { lang: Lang }
const { lang } = Astro.props;
const l = (lang === "id" ? id : en).lightbox;
---
<dialog class="lb" id="lb" aria-label={l.label} data-alt={l.alt} data-photos={l.photos}>
  <header class="lb-head">
    <div>
      <p class="lb-h" data-lb-heading></p>
      <p class="lb-total" data-lb-total></p>
    </div>
    <button type="button" class="lb-x" data-lb="close" aria-label={l.close}>✕</button>
  </header>
  <!-- grid of every photo (built by lightbox.ts on open); a click shows that photo large -->
  <ul class="lb-grid" data-lb-grid hidden></ul>
  <div class="lb-stage">
    <button type="button" class="lb-back" data-lb="grid" hidden>{l.all}</button>
    <button type="button" class="lb-nav prev" data-lb="prev" aria-label={l.prev}>‹</button>
    <figure hidden>
      <p class="lb-error" data-lb-error hidden>{l.error}</p>
      <figcaption class="mono" aria-live="polite"><span data-lb-title></span> · <span data-lb-count></span></figcaption>
    </figure>
    <button type="button" class="lb-nav next" data-lb="next" aria-label={l.next}>›</button>
  </div>
</dialog>
<script>
  import { initLightbox } from "../scripts/lightbox";
  initLightbox();
</script>
