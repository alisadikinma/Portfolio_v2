---
// Language switch, rendered twice by the Header: as flags in the bar (desktop) and as a labelled
// row inside the phone menu (Ali 2026-11-09: on phones the flags move into the menu).
import type { Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  alts: Record<Lang, string>;
  canSwitch: boolean;
  label: string;
  variant: "bar" | "menu";
}
const { lang, alts, canSwitch, label, variant } = Astro.props;
// Native names, the same on both language versions (a reader looks for their own language).
const LANG_NAME: Record<Lang, string> = { id: "Bahasa Indonesia", en: "English" };
const order: Lang[] = ["en", "id"]; // same order as the live site: US, then ID
const bar = variant === "bar";
---
<div class={bar ? "lang-sw" : "lang-menu"} role="group" aria-label={label}>
  {order.map((l) => {
    const flag = l === "id"
      ? <svg viewBox="0 0 3 2" width="22" height="15" aria-hidden="true"><rect width="3" height="1" fill="#CE1126"/><rect y="1" width="3" height="1" fill="#FFF"/></svg>
      : <svg viewBox="0 0 19 10" width="22" height="15" aria-hidden="true"><rect width="19" height="10" fill="#FFF"/><path d="M0 0h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19v.77H0zm0 1.54h19V10H0z" fill="#B22234"/><rect width="7.6" height="5.39" fill="#3C3B6E"/></svg>;
    const name = bar ? <span class="sr-only">{LANG_NAME[l]}</span> : <span>{LANG_NAME[l]}</span>;
    if (l === lang) return <span class="flag is-on" aria-current="true" title={LANG_NAME[l]}>{flag}{name}</span>;
    return canSwitch ? <a class="lang flag" href={alts[l]} hreflang={l} lang={l} title={LANG_NAME[l]}>{flag}{name}</a> : null;
  })}
</div>
