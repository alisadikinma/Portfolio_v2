---
import type { Lang } from "../lib/i18n";
import { imageOrigin, largestUrl, srcsetOf, variantList } from "../lib/post-images";

export interface PostItem {
  slug: string;
  title: string;
  excerpt?: string | null;
  featured_image?: string | null;
  image_variants?: Record<string, string> | null;
  published_at?: string | null;
  reading_time?: number | null;
  category?: { name?: string } | null;
  /** Languages the post exists in; the card links to one of them. */
  available_translations?: string[] | null;
  /** This language's own slug (API `localized_slug`); the post page 301s other slugs to it. */
  localized_slug?: string | null;
}
interface Props {
  post: PostItem;
  lang: Lang;
  minRead: string;
  /** First card above the fold: not lazy. */
  eager?: boolean;
  /** Language of the link target (default: lang). Used when the post only exists in the other language. */
  hrefLang?: Lang;
}
const { post, lang, minRead, eager = false, hrefLang = lang } = Astro.props;
const href = `/${hrefLang}/blog/${encodeURIComponent((hrefLang === lang && post.localized_slug) || post.slug)}`;
const W = 640;
const H = 360;

// image_variants keys look like "320w": "/storage/..."; paths are relative to the API origin.
const origin = imageOrigin(post.featured_image);
const variants = variantList(post.image_variants, origin);
const srcset = srcsetOf(variants);
const src = post.featured_image ?? largestUrl(variants) ?? "";

const date = post.published_at ? new Date(post.published_at) : null;
const validDate = date && !Number.isNaN(date.getTime()) ? date : null;
const dateLabel = validDate
  ? new Intl.DateTimeFormat(lang === "id" ? "id-ID" : "en-US", { dateStyle: "long", timeZone: "UTC" }).format(validDate)
  : "";
---
<article class="post-card">
  {src && (
    <a href={href} class="post-card-media" tabindex="-1" aria-hidden="true">
      <img
        src={src}
        srcset={srcset}
        sizes={srcset ? "(min-width: 900px) 360px, 100vw" : undefined}
        width={W}
        height={H}
        alt=""
        aria-hidden="true"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </a>
  )}
  <div class="post-card-body">
    <p class="post-card-meta">
      {post.category?.name && <span>{post.category.name}</span>}
      {validDate && <time datetime={validDate.toISOString()}>{dateLabel}</time>}
      {post.reading_time ? <span>{post.reading_time} {minRead}</span> : null}
    </p>
    <h2><a href={href}>{post.title}</a></h2>
    {post.excerpt && <p class="post-card-excerpt">{post.excerpt}</p>}
  </div>
</article>
<style>
  .post-card { display: flex; flex-direction: column; gap: 0.75rem; }
  .post-card-media { display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 12px; }
  .post-card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post-card-meta { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; font-size: 0.85rem; opacity: 0.75; margin: 0; }
  .post-card h2 { font-size: 1.25rem; margin: 0.25rem 0; }
  .post-card h2 a { color: inherit; text-decoration: none; }
  .post-card h2 a:hover, .post-card h2 a:focus-visible { text-decoration: underline; }
  .post-card-excerpt { margin: 0; }
</style>
