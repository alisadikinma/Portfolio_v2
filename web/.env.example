# Laravel API reached from the Astro server (never exposed to the browser).
# Production: the loopback nginx listener (scripts/nginx/portfolio-8080.conf, 127.0.0.1:8081).
# It also serves /api/internal/*, which the public :8080 server answers with 404.
API_INTERNAL_URL=http://127.0.0.1:8081/api
# Same-host /storage + /uploads image reads (image width/height) skip Cloudflare. Optional.
IMAGE_DIMS_ORIGIN=http://127.0.0.1:8081
SITE_URL=https://alisadikinma.com
GA4_MEASUREMENT_ID=
# Required when NODE_ENV=production. Must equal INTERNAL_API_TOKEN in backend/.env.
# Generate once: openssl rand -hex 32
INTERNAL_API_TOKEN=
HOST=127.0.0.1
PORT=4321
