# video-full-worker — env contract (committable template; copy to .env and fill)
# Load: `npm start` (node --env-file=.env) or `node --env-file=.env index.js`

# ── VPS bridge (Phase E) ──────────────────────────────────────────────
VIDEO_FULL_BRIDGE_URL=https://alisadikinma.com/api
# Mint on the VPS: php artisan tinker --execute=\
#   "echo User::find(1)->createToken('video-full-worker',['video-full:work'])->plainTextToken;"
VIDEO_FULL_WORKER_TOKEN=

# ── GeminiGen (image keyframe + Veo/GROK i2v) — same HTTP API as backend ──
GEMINIGEN_API_KEY=

# ── Whisper (ASR) — point at a REAL ggml model (not the tiny stub) ────
# e.g. curl -L -o ~/.cache/whisper/ggml-base.en.bin \
#   https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin
WHISPER_MODEL=

# ── Voice change — RVC primary (local), ElevenLabs fallback ───────────
# RVC_CLI=
# RVC_MODEL=
# RVC_INDEX=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ── Optional overrides (sane defaults in config.js) ───────────────────
# VIDEO_FULL_WORK_DIR=
# VIDEO_FULL_ALI_FACE_URL=
# VIDEO_FULL_SCENE_THRESHOLD=0.3
# VIDEO_FULL_POLL_MS=15000
