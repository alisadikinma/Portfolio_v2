# API Configuration
# Development: http://localhost/Portfolio_v2/backend/public/api
# Production: https://yourdomain.com/api
VITE_APP_NAME=Portfolio V2
VITE_API_BASE_URL=http://localhost/Portfolio_v2/backend/public/api
VITE_API_URL=http://localhost/Portfolio_v2/backend/public/api

# Feature Flags
VITE_ENABLE_DEBUG=true

# GA4 Measurement ID — when empty, no gtag.js loads and no network request
# fires (dev-safe). Set to e.g. G-XXXXXXXXXX in production to measure human
# referrals from AI chats. See docs/runbooks/geo-ai-traffic-ga4.md.
VITE_GA4_MEASUREMENT_ID=
