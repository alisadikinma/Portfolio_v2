# ====================================
# Laravel Backend (backend/)
# ====================================

# Dependencies
backend/vendor/
backend/node_modules/

# Environment files
backend/.env
backend/.env.backup
backend/.env.production

# Storage & Cache
backend/storage/*.key
backend/storage/app/*
!backend/storage/app/.gitkeep
!backend/storage/app/public/
backend/storage/app/public/*
!backend/storage/app/public/.gitkeep
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitkeep
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitkeep
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitkeep
backend/storage/framework/views/*
!backend/storage/framework/views/.gitkeep
backend/storage/logs/*
!backend/storage/logs/.gitkeep

# Bootstrap cache
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitkeep

# Laravel specific
backend/public/storage
backend/public/hot

# Testing
backend/.phpunit.result.cache
backend/coverage/

# ====================================
# Vue Frontend (frontend/)
# ====================================

# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js

# Production build
frontend/dist/
frontend/build/

# Environment files
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/lerna-debug.log*

# Vite cache
frontend/.vite/

# Testing
frontend/coverage/
frontend/.nyc_output/

# ====================================
# Claude Code & Raw Data
# ====================================

# Raw data files (HTML/PNG - too large for git)
.claude/raw_data/*.html
.claude/raw_data/*.png

# Keep directory structure
!.claude/raw_data/.gitkeep

# Logs and temp files
.claude/logs/
.claude/temp/

# Session lock files (runtime state, never commit)
.claude/scheduled_tasks.lock
.claude/*.lock

