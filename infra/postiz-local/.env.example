# Postiz local-node — copy to .env and fill in. NEVER commit the real .env.
# See docs/runbooks/postiz-local-node-deploy.md.

# ── Postiz core ─────────────────────────────────────────────────────────────
# Public URL = the Cloudflare NAMED tunnel hostname (stable; quick-tunnel's
# random URL breaks OAuth redirect URIs). Must match each dev-app redirect URI.
POSTIZ_PUBLIC_URL=https://postiz.alisadikinma.com
# Long random string, unique per install (e.g. `openssl rand -hex 32`).
POSTIZ_JWT_SECRET=change-me-to-a-long-random-string
# Throttle (per hour). 300 comfortably covers a 10-item video carousel (~11 calls).
POSTIZ_API_LIMIT=300

# ── Social OAuth dev-app keys (fill only the platforms you connect) ─────────
# Instagram/Facebook share the Meta app (FACEBOOK_*). LinkedIn separate, etc.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# ── Poller (our dumb executor) ──────────────────────────────────────────────
# VPS automation API base + bearer token (mint via admin Automation Tokens).
VPS_API_BASE_URL=https://alisadikinma.com/api
VPS_AUTOMATION_TOKEN=
# Postiz API key (Postiz UI → Settings → Developers). Internal base URL is set
# in docker-compose (http://postiz:5000) — override here only if running the
# poller outside the compose network.
POSTIZ_API_KEY=
# POSTIZ_API_BASE_URL=http://localhost:4007   # only if poller runs on the host
POLLER_WORKER_ID=local-1
