[Unit]
# Laravel queue worker for Portfolio_v2.
#
# Without this unit, jobs dispatched to QUEUE_CONNECTION=database (the project
# default — see backend/.env.example:39) accumulate in the `jobs` MySQL table
# but never run. This causes carousel image generation, LinkedIn scan jobs,
# and `RegenerateLinkedInCarouselContent` runs to silently stall.
#
# Install on VPS:
#   sudo cp scripts/systemd/portfolio-queue.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable portfolio-queue.service
#   sudo systemctl start portfolio-queue.service
#   sudo systemctl status portfolio-queue.service
#
# `php artisan queue:restart` (run by deploy.sh step 7) signals this worker
# to gracefully reload after a deploy.
Description=Portfolio_v2 Laravel queue worker
After=network.target mysql.service

[Service]
Type=simple
# Run as the same user that owns the Laravel project + has Claude CLI auth
# for SSH-driven plugin invocations (LinkedInGenerationService et al).
User=claudesn
Group=claudesn
WorkingDirectory=/var/www/Portfolio_v2/backend
# --queue=default — single-queue dispatch (Laravel default). Add more queues
#                     here if Portfolio_v2 ever splits high-priority lanes.
# --sleep=3       — poll interval when queue is empty (3s = responsive but
#                     not busy-loopy).
# --tries=3       — match the per-job ::tries for jobs that don't override.
# --timeout=1260  — per-job hard timeout (21 min). Must be >= the longest
#                     job class $timeout. GenerateLinkedInPost has
#                     $timeout=1260 (covers TWO 600s SSH calls when the
#                     format-mix governor re-dispatches /linkedin-gen with
#                     format_preference=carousel — see
#                     LinkedInGenerationService line 180, May 12 2026).
#                     Pre-May-13 value of 600s killed governor over-rides
#                     mid-second-call, leaving rows stuck in `generating`
#                     until the reaper (production incident May 13).
#                     GenerateInstagram/Tiktok/Threads jobs have $timeout=360
#                     and fit comfortably under the higher ceiling.
# --max-time=3600 — recycle worker every hour to release accumulated memory.
#                     systemd Restart=always brings it back instantly.
# --backoff=60,300,900 — escalating retry delay; matches GenerateLinkedInPost
#                          + RegenerateLinkedInCarouselContent class settings.
ExecStart=/usr/bin/php artisan queue:work --queue=default --sleep=3 --tries=3 --timeout=1260 --max-time=3600 --backoff=60,300,900
# SIGKILL events (signal 9 = exit status 137) treated as success so the
# unit doesn't hit StartLimitBurst on repeated kills (4× observed
# May 6-7 2026; see investigation in CLAUDE.md). Without this, repeated
# kills could disable the unit and silently halt the entire pipeline.
SuccessExitStatus=137 SIGKILL
# MemoryHigh sets kernel pressure threshold before any kill — the cgroup
# gets gradual reclaim instead of sudden SIGKILL when claude subprocess
# spikes during /carousel-gen runs. Combined with the 2GB swap activated
# 2026-05-07 (/swapfile), gives kernel headroom to swap pages instead
# of OOM-kill. 4G threshold leaves room for queue worker (~75MB), claude
# subprocess (~250MB), plus burst overhead.
MemoryHigh=4G
# MaxRSS=6G as a hard ceiling — kernel will SIGKILL before exceeding
# this (defense-in-depth; in practice MemoryHigh kicks in first and
# reclaim kicks in via swap before MemoryMax is breached).
MemoryMax=6G
Restart=always
RestartSec=10
# Pipe stdout/stderr to journald — `journalctl -u portfolio-queue -f` to tail.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=portfolio-queue

[Install]
WantedBy=multi-user.target
